VITE_API_URL=http://localhost:4000

# Firebase. By default the portal uses the local emulators (npm run emulators).
# For the real project set VITE_USE_FIREBASE_EMULATORS=false and copy the web app
# config from Firebase console → Project settings → Your apps.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-journeybuddy
VITE_FIREBASE_APP_ID=
