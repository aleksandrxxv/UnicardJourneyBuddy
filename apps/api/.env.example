PORT=4000

# Real bus journeys from OpenTripPlanner (npm run otp). See ADR-0002.
OTP_URL=http://localhost:8090

# Firebase. By default the API uses the local emulators (npm run emulators).
# To use the real project instead:
#   USE_FIREBASE_EMULATORS=false
#   FIREBASE_PROJECT_ID=<your project id>
#   FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json   (never commit this file)
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-journeybuddy
FIREBASE_SERVICE_ACCOUNT_PATH=
