{
  "compilerOptions": {
    "target": "ES2022",
    // The API runs with tsx (dev and start), which resolves the TypeScript-only
    // @journeybuddy/shared package. tsc is used for type checking only.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
