# Public (bundled into the app) — never put secrets here.
# Leave unset in development: the app then uses your computer's Wi-Fi address,
# so Expo Go on a phone can reach the local API on port 4000.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Firebase. Uses the local emulators unless set to false.
# For the real project copy the web app config from Firebase console → Project settings.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-journeybuddy
EXPO_PUBLIC_FIREBASE_APP_ID=
