rules_version = '2';

// All data access goes through the Express API (firebase-admin bypasses these rules).
// Clients get no direct access. See docs/05-architecture/adr/0003-authentication-with-firebase.md
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
